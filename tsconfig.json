{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["components/*"]
    }
  },
  "include": ["src", "index.js", "index.ts", "index.tsx", "App.tsx", "nativewind-env.d.ts"],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "src/bridge/generate-schemas.ts",
    "src/components/ui/examples.tsx",
    "Figma"
  ]
}
