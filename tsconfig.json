{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@hdkit/*": ["hdkit/*"],
      "@components/*": ["components/*"]
    }
  },
  "include": ["src", "index.js", "index.ts", "index.tsx", "App.tsx"],
  "exclude": ["node_modules", "android", "ios"]
}
