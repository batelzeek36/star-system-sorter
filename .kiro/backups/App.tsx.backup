                    <button className="px-4 py-2.5 bg-purple-600 border-2 border-purple-400 text-sm tracking-wider">
                      BIRTH DATA
                    </button>
                    <button className="px-4 py-2.5 bg-transparent border-2 border-purple-500/30 text-sm text-gray-500 tracking-wider">
                      UPLOAD PDF
                    </button>
                  </div>

                  {/* Form */}
                  <div className="space-y-4 mb-auto">
                    <div>
                      <label className="text-xs text-purple-300 mb-2 block tracking-wider uppercase">Date of Birth</label>
                      <div className="px-4 py-3 bg-purple-950/30 border-2 border-purple-700/40 flex items-center gap-3 relative">
                        <div className="absolute top-0 right-0 w-2 h-2 bg-amber-400"></div>
                        <Calendar className="w-4 h-4 text-purple-400" />
                        <input 
                          type="text" 
                          placeholder="MM/DD/YYYY" 
                          className="bg-transparent outline-none flex-1 text-sm text-white placeholder:text-gray-700"
                        />
                      </div>
                    </div>

                    <div>
                      <label className="text-xs text-purple-300 mb-2 block tracking-wider uppercase">Time of Birth</label>
                      <div className="px-4 py-3 bg-purple-950/30 border-2 border-purple-700/40 flex items-center gap-3 relative">
                        <div className="absolute top-0 right-0 w-2 h-2 bg-amber-400"></div>
                        <Clock className="w-4 h-4 text-purple-400" />
                        <input 
                          type="text" 
                          placeholder="HH:MM AM/PM" 
                          className="bg-transparent outline-none flex-1 text-sm text-white placeholder:text-gray-700"
                        />
                      </div>
                    </div>

                    <div>
                      <label className="text-xs text-purple-300 mb-2 block tracking-wider uppercase">Location</label>
                      <div className="px-4 py-3 bg-purple-950/30 border-2 border-purple-700/40 flex items-center gap-3 relative">
                        <div className="absolute top-0 right-0 w-2 h-2 bg-amber-400"></div>
                        <MapPin className="w-4 h-4 text-purple-400" />
                        <input 
                          type="text" 
                          placeholder="CITY, COUNTRY" 
                          className="bg-transparent outline-none flex-1 text-sm text-white placeholder:text-gray-700"
                        />
                      </div>
                    </div>
                  </div>

                  {/* CTA */}
                  <div className="pt-6">
                    <button className="w-full px-6 py-4 bg-purple-600 border-2 border-purple-400 text-white relative overflow-hidden group">
                      <span className="relative z-10 tracking-wider">COMPUTE CHART</span>
                      <div className="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
                    </button>
                  </div>

                  <div className="h-8"></div>
                </div>
              </div>
            </div>

            {/* Result B */}
            <div className="flex flex-col">
              <p className="text-sm text-amber-300 mb-3">3. Sort Result</p>
              <div className="w-full aspect-[393/852] bg-[#0a0612] rounded-[3rem] border-4 border-gray-800 p-6 flex flex-col relative overflow-hidden">
                <div className="absolute inset-0 opacity-10" style={{
                  backgroundImage: 'linear-gradient(rgba(139, 92, 246, 0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.5) 1px, transparent 1px)',
                  backgroundSize: '20px 20px'
                }}></div>
                
                <div className="relative flex-1 flex flex-col">
                  <div className="h-12"></div>
                  
                  <div className="mb-6 pb-3 border-b-2 border-purple-500/30">
                    <p className="text-xs text-purple-400 mb-1 tracking-wider uppercase">Your Primary Star System</p>
                    <h2 className="text-2xl text-purple-200 tracking-wider uppercase">Pleiades</h2>
                  </div>

                  {/* Radial Chart - more technical */}
                  <div className="flex justify-center mb-6">
                    <div className="relative w-48 h-48">
                      {/* Background grid */}
                      <div className="absolute inset-0" style={{
                        backgroundImage: 'linear-gradient(rgba(139, 92, 246, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.2) 1px, transparent 1px)',
                        backgroundSize: '8px 8px'
                      }}></div>
                      
                      {/* Outer ring */}
                      <svg className="w-full h-full transform -rotate-90 relative z-10">
                        <circle
                          cx="96"
                          cy="96"
                          r="80"
                          stroke="rgba(139, 92, 246, 0.2)"
                          strokeWidth="12"
                          fill="none"
                        />
                        <circle
                          cx="96"
                          cy="96"
                          r="80"
                          stroke="#8b5cf6"
                          strokeWidth="12"
                          fill="none"
                          strokeDasharray={`${2 * Math.PI * 80 * 0.62} ${2 * Math.PI * 80}`}
                        />
                      </svg>
                      
                      <div className="absolute inset-0 flex items-center justify-center flex-col">
                        <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 bg-amber-400"></div>
                        <p className="text-5xl mb-1 text-purple-200 tracking-wider">62</p>
                        <p className="text-xs text-gray-500 tracking-widest uppercase">Percent</p>
                      </div>
                    </div>
                  </div>

                  {/* Ally chips */}
                  <div className="mb-6">
                    <p className="text-xs text-gray-500 mb-3 tracking-widest uppercase">Ally Star Systems</p>
                    <div className="flex flex-wrap gap-2">
                      <div className="px-3 py-1.5 bg-amber-500/20 border-2 border-amber-400/60 text-xs text-amber-300 tracking-wider uppercase">
                        Sirius 18%
                      </div>
                      <div className="px-3 py-1.5 bg-amber-500/20 border-2 border-amber-400/60 text-xs text-amber-300 tracking-wider uppercase">
                        Lyra 12%
                      </div>
                      <div className="px-3 py-1.5 bg-purple-500/20 border-2 border-purple-400/50 text-xs text-purple-300 tracking-wider uppercase">
                        Andromeda 8%
                      </div>
                    </div>
                  </div>

                  {/* Buttons */}
                  <div className="space-y-3 mb-4">
                    <button className="w-full px-6 py-3.5 bg-purple-600 border-2 border-purple-400 text-sm tracking-wider relative overflow-hidden group">
                      <span className="relative z-10">VIEW WHY</span>
                      <div className="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
                    </button>
                    <button className="w-full px-6 py-3.5 bg-transparent border-2 border-purple-500/50 text-sm tracking-wider">
                      GENERATE NARRATIVE
                    </button>
                  </div>

                  {/* Disclaimer */}
                  <div className="p-3 bg-purple-950/30 border-2 border-purple-800/40 relative">
                    <div className="absolute top-1 right-1 w-2 h-2 bg-amber-400"></div>
                    <p className="text-xs text-gray-500 leading-relaxed">
                      For insight & entertainment. Not medical, financial, or legal advice.
                    </p>
                  </div>

                  <div className="h-8"></div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  );
}
