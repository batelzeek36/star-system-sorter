{
  "name": "star-system-sorter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint:graph": "dependency-cruiser --config .dependency-cruiser.js src",
    "start": "react-native start",
    "test": "jest",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "build:detox:ios": "detox build --configuration ios.sim.debug",
    "build:detox:android": "detox build --configuration android.emu.debug",
    "rebuild:ios": "bash scripts/rebuild-native.sh ios",
    "rebuild:android": "bash scripts/rebuild-native.sh android",
    "rebuild:all": "bash scripts/rebuild-native.sh both",
    "reload:ios": "bash scripts/reload-app.sh ios",
    "reload:android": "bash scripts/reload-app.sh android",
    "reload:both": "bash scripts/reload-app.sh both",
    "reload:ios:clean": "bash scripts/reload-app.sh ios --clean",
    "reload:android:clean": "bash scripts/reload-app.sh android --clean",
    "reload:both:clean": "bash scripts/reload-app.sh both --clean",
    "postinstall": "cd ios && bundle exec pod install && cd .."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/new-app-screen": "0.82.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.27",
    "pako": "^2.1.0",
    "react": "19.1.1",
    "react-hook-form": "^7.64.0",
    "react-native": "0.82.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.14.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@mswjs/interceptors": "^0.39.7",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.0",
    "@react-native/eslint-config": "0.82.0",
    "@react-native/metro-config": "0.82.0",
    "@react-native/typescript-config": "0.82.0",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/react-native": "^3.0.7",
    "@types/jest": "^29.5.13",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.2",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dependency-cruiser": "^17.0.2",
    "detox": "^20.43.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "msw": "^2.11.4",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.9.3",
    "zod-to-json-schema": "^3.24.6"
  },
  "engines": {
    "node": ">=20"
  }
}
