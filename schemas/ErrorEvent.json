{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorEvent",
  "description": "Event sent when an error occurs in the Flutter game",
  "type": "object",
  "required": [
    "type",
    "code",
    "message"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "error"
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  }
}