{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GameEvent",
  "description": "Union of all game events sent from Flutter to React Native",
  "oneOf": [
    {
      "$ref": "./ReadyEvent.json"
    },
    {
      "$ref": "./StateEvent.json"
    },
    {
      "$ref": "./ResultEvent.json"
    },
    {
      "$ref": "./ErrorEvent.json"
    }
  ],
  "discriminator": {
    "propertyName": "type"
  }
}